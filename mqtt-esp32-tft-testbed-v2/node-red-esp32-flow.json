  {
    "id": "e300000000000026",
    "type": "function",
    "z": "e300000000000001",
    "name": "Set control mode",
    "x": 390,
    "y": 980,
    "wires": [
      [
        "e300000000000023"
      ],
      [
        "e300000000000024"
      ]
    ],
    "func": "const automatic = msg.payload === true;\nflow.set(\"auto\", automatic);\nreturn [\n    {payload: automatic ? \"AUTO\" : \"MANUAL\"},\n    {payload: flow.get(\"fan_state\") || \"OFF\", enabled: !automatic}\n];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": []
  },
  {
    "id": "e300000000000027",
    "type": "function",
    "z": "e300000000000001",
    "name": "Manual command guard",
    "x": 390,
    "y": 900,
    "wires": [
      [
        "e300000000000007"
      ]
    ],
    "func": "if (flow.get(\"auto\") === true) {\n    node.warn(\"Disable Automatic control before sending manual commands\");\n    return null;\n}\nif (msg.payload !== \"ON\" && msg.payload !== \"OFF\") return null;\nmsg.topic = \"lab/room1/fan/set\";\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": []
  },
  {
    "id": "e300000000000028",
    "type": "function",
    "z": "e300000000000001",
    "name": "Reported fan feedback",
    "x": 370,
    "y": 720,
    "wires": [
      [
        "e300000000000022"
      ],
      [
        "e300000000000024"
      ]
    ],
    "func": "if (msg.payload !== \"ON\" && msg.payload !== \"OFF\") return null;\nflow.set(\"fan_state\", msg.payload);\nreturn [msg, {payload: msg.payload, enabled: flow.get(\"auto\") !== true}];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": []
  },
