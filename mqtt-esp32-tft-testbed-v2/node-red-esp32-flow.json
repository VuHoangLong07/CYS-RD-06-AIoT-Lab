  {
    "id": "e300000000000006",
    "type": "function",
    "z": "e300000000000001",
    "name": "Fan controller",
    "x": 610,
    "y": 140,
    "wires": [
      [
        "e300000000000007"
      ]
    ],
    "func": "const data = msg.payload;\nif (!data || typeof data.temperature !== \"number\" || !Number.isFinite(data.temperature)) {\n    node.warn(\"Expected JSON with a finite numeric temperature\");\n    return null;\n}\nif (flow.get(\"auto\") !== true) return null;\nlet state = flow.get(\"fan_state\") || context.get(\"fan\") || \"OFF\";\nif (data.temperature >= 28) state = \"ON\";\nelse if (data.temperature <= 26) state = \"OFF\";\ncontext.set(\"fan\", state);\nmsg.topic = \"lab/room1/fan/set\";\nmsg.payload = state;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": []
  },
