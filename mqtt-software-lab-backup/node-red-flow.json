  {
    "id": "a100000000000006",
    "type": "function",
    "z": "a100000000000001",
    "name": "Fan controller",
    "x": 610,
    "y": 140,
    "wires": [
      [
        "a100000000000007"
      ]
    ],
    "func": "// Input is an object produced by the JSON node.\nconst data = msg.payload;\nif (!data || typeof data.temperature !== \"number\" || !Number.isFinite(data.temperature)) {\n    node.warn(\"Expected JSON with a finite numeric temperature\");\n    return null;\n}\n// Two thresholds prevent rapid ON/OFF changes near one temperature.\nlet state = context.get(\"fan\") || \"OFF\";\nif (data.temperature >= 28) state = \"ON\";\nelse if (data.temperature <= 26) state = \"OFF\";\ncontext.set(\"fan\", state);\n// Send a current command for every reading. Commands are not retained.\nmsg.topic = \"lab/room1/fan/set\";\nmsg.payload = state;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": []
  },
